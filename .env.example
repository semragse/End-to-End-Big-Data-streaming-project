# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_TOPIC=ecommerce_orders

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_password

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=13000

# ─── Producer ─────────────────────────────────────────────────────────────────
API_URL=https://dummyjson.com/carts
API_VERIFY_SSL=true
ORDER_LIMIT=10
PRODUCER_SLEEP_SECONDS=5

# ─── Spark ────────────────────────────────────────────────────────────────────
SPARK_CHECKPOINT_LOCATION=/tmp/spark-checkpoints/ecommerce_orders

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=ecommerce_airflow_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_HOST_PORT=18081
